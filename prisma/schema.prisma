generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum RoleName {
  USER
  ADVERTISER
  PUBLISHER
  WHATSAPP_AGENT
  ADMIN
  SUPER_ADMIN
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  AWAITING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REJECTED
}

enum Platform {
  TELEGRAM_CHANNEL
  TELEGRAM_GROUP
  WHATSAPP_CHANNEL
  WHATSAPP_GROUP
  WEBSITE
}

enum Objective {
  MEMBERS
  VIEWS
  CLICKS
  EXPOSURE
}

enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  CAMPAIGN_CHARGE
  PUBLISHER_EARNING
  AGENT_EARNING
  REFUND
  COMMISSION
  ADJUSTMENT
}

enum LedgerStatus {
  PENDING
  POSTED
  VOIDED
}

enum ModerationAction {
  APPROVE
  REJECT
  REQUEST_CHANGES
  BAN_ADVERTISER
}

enum TicketCategory {
  PAYMENT
  CAMPAIGN
  PUBLISHER
  AGENT
  TECHNICAL
  REPORT
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationType {
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_STARTED
  BUDGET_LOW
  CAMPAIGN_COMPLETED
  WALLET_TRANSACTION
  WITHDRAWAL_UPDATE
  SUPPORT_TICKET_UPDATE
  CAMPAIGN_ACTIVE
  PLACEMENT_COMPLETED
  CAMPAIGN_OPPORTUNITY
  PLACEMENT_DEADLINE
  PLACEMENT_APPROVED
  PAYMENT_RECEIVED
  PERFORMANCE_UPDATE
  CAMPAIGN_AVAILABLE
  CAMPAIGN_ACCEPTED
  PLACEMENT_SUBMITTED
  PLACEMENT_REJECTED
  EARNINGS_CREDITED
  WITHDRAWAL_COMPLETED
}

enum PublisherStatus {
  PENDING
  ACTIVE
  PAUSED
  SUSPENDED
  REJECTED
}

enum AgentStatus {
  PENDING
  ACTIVE
  PAUSED
  SUSPENDED
  REJECTED
}

enum ApprovalMode {
  MANUAL
  AUTOMATIC
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum PlacementStatus {
  PENDING
  APPROVED
  SCHEDULED
  POSTED
  FAILED
  REJECTED
  EXPIRED
}

enum AgentOpportunityStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AgentSubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum RatingTargetType {
  ADVERTISER
  PUBLISHER
  AGENT
}

enum ReferralType {
  ADVERTISER
  PUBLISHER
  AGENT
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  PAID
  REJECTED
}

model User {
  id                 String                     @id @default(cuid())
  telegramId         String                     @unique
  username           String?
  firstName          String
  lastName           String?
  status             UserStatus                 @default(ACTIVE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  lastActiveAt       DateTime                   @default(now())
  roles              UserRole[]
  wallet             Wallet?
  advertiser         Advertiser?
  publisher          Publisher?
  agent              Agent?
  campaigns          Campaign[]
  tickets            SupportTicket[]
  ledger             Transactions[]
  notifications      Notification[]
  moderationLogs     ModerationLog[]
  agentOpportunities AgentOpportunity[]
  agentSubmissions   AgentPlacementSubmission[]
  ratingsGiven       Rating[]                   @relation("RatingsGiven")
  ratingsReceived    Rating[]                   @relation("RatingsReceived")
  referralsMade      Referral[]                 @relation("Referrer")
  referralsReceived  Referral[]                 @relation("Referee")
  withdrawals        Withdrawal[]
}

model UserRole {
  userId String
  role   RoleName
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Advertiser {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  campaigns Campaign[]
}

model Publisher {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  status             PublisherStatus    @default(PENDING)
  category           String?
  description        String?
  audienceLocation   String?
  advertisingPrice   Int                @default(0)
  maxAdsPerDay       Int                @default(1)
  acceptedCategories String?
  approvalMode       ApprovalMode       @default(MANUAL)
  availability       AvailabilityStatus @default(AVAILABLE)
  communities        Community[]
  placements         Placement[]
}

model Agent {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  user               User                       @relation(fields: [userId], references: [id])
  status             AgentStatus                @default(PENDING)
  contactInformation String?
  country            String?
  areas              String?
  platformType       String?
  acceptedCategories String?
  paymentDetails     String?
  availability       AvailabilityStatus         @default(AVAILABLE)
  opportunities      AgentOpportunity[]
  submissions        AgentPlacementSubmission[]
  placements         Placement[]
}

model Community {
  id                  String      @id @default(cuid())
  publisherId         String
  publisher           Publisher   @relation(fields: [publisherId], references: [id])
  name                String
  platform            Platform
  audienceSize        Int?
  communityType       String?
  category            String?
  description         String?
  targetLocation      String?
  memberCountVerified Boolean     @default(false)
  placements          Placement[]
}

model Campaign {
  id                String                     @id @default(cuid())
  publicId          String                     @unique
  advertiserId      String
  advertiser        Advertiser                 @relation(fields: [advertiserId], references: [id])
  title             String
  destination       String
  description       String
  advertisementText String
  mediaUrl          String?
  category          String?
  targetAudience    String?
  targetLocation    String?
  budget            Int
  spentAmount       Int                        @default(0)
  remainingBalance  Int
  platform          Platform
  objective         Objective
  startDate         DateTime?
  endDate           DateTime?
  status            CampaignStatus             @default(DRAFT)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  advertisements    Advertisement[]
  placements        Placement[]
  analytics         CampaignAnalytics[]
  moderationLogs    ModerationLog[]
  user              User?                      @relation(fields: [userId], references: [id])
  userId            String?
  trackingLinks     TrackingLink[]
  ratings           Rating[]
  opportunities     AgentOpportunity[]
  submissions       AgentPlacementSubmission[]
  allocations       CampaignAllocation[]
  clickEvents       ClickEvent[]
}

model Advertisement {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  content    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model Placement {
  id                String                     @id @default(cuid())
  campaignId        String
  campaign          Campaign                   @relation(fields: [campaignId], references: [id])
  communityId       String
  community         Community                  @relation(fields: [communityId], references: [id])
  publisherId       String?
  publisher         Publisher?                 @relation(fields: [publisherId], references: [id])
  agentId           String?
  agent             Agent?                     @relation(fields: [agentId], references: [id])
  price             Int                        @default(0)
  status            PlacementStatus            @default(PENDING)
  scheduledAt       DateTime?
  postedAt          DateTime?
  telegramMessageId String?
  destination       String?
  trackingLink      TrackingLink?
  submissions       AgentPlacementSubmission[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([publisherId, createdAt])
}

model Wallet {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  availableBalance Int            @default(0)
  pendingBalance   Int            @default(0)
  totalSpent       Int            @default(0)
  totalEarned      Int            @default(0)
  transactions     Transactions[]
}

model Transactions {
  id             String       @id @default(cuid())
  idempotencyKey String       @unique
  walletId       String
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  wallet         Wallet       @relation(fields: [walletId], references: [id])
  amount         Int
  type           LedgerType
  status         LedgerStatus @default(POSTED)
  description    String
  metadata       String?
  createdAt      DateTime     @default(now())
}

model Withdrawal {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  amount           Int
  status           WithdrawalStatus @default(PENDING)
  paymentReference String?
  adminNote        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Deposit {
  id                String   @id @default(cuid())
  userId            String
  amount            Int
  providerReference String   @unique
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
}

model TrackingLink {
  id          String       @id @default(cuid())
  campaignId  String
  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  placementId String       @unique
  placement   Placement    @relation(fields: [placementId], references: [id])
  token       String       @unique
  destination String
  clicks      Int          @default(0)
  clickEvents ClickEvent[]
  createdAt   DateTime     @default(now())
}

model CampaignAnalytics {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  recordedAt  DateTime @default(now())
}

model Rating {
  id                String           @id @default(cuid())
  campaignId        String
  campaign          Campaign         @relation(fields: [campaignId], references: [id])
  raterId           String
  rater             User             @relation("RatingsGiven", fields: [raterId], references: [id])
  targetUserId      String
  target            User             @relation("RatingsReceived", fields: [targetUserId], references: [id])
  targetType        RatingTargetType
  communityQuality  Int?
  audienceRelevance Int?
  performance       Int?
  score             Int
  comment           String?
  createdAt         DateTime         @default(now())

  @@unique([campaignId, raterId, targetUserId])
}

model Referral {
  id              String         @id @default(cuid())
  referrerId      String
  referrer        User           @relation("Referrer", fields: [referrerId], references: [id])
  refereeId       String
  referee         User           @relation("Referee", fields: [refereeId], references: [id])
  type            ReferralType
  qualifyingEvent String
  reward          Int            @default(0)
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  paidAt          DateTime?

  @@unique([referrerId, refereeId, qualifyingEvent])
}

model SupportTicket {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  category        TicketCategory
  subject         String
  message         String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assignedAdminId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model ModerationLog {
  id          String           @id @default(cuid())
  campaignId  String
  campaign    Campaign         @relation(fields: [campaignId], references: [id])
  moderatorId String
  moderator   User             @relation(fields: [moderatorId], references: [id])
  action      ModerationAction
  reason      String?
  createdAt   DateTime         @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

model AgentOpportunity {
  id         String                 @id @default(cuid())
  campaignId String
  campaign   Campaign               @relation(fields: [campaignId], references: [id])
  agentId    String
  agent      Agent                  @relation(fields: [agentId], references: [id])
  reward     Int
  deadline   DateTime?
  status     AgentOpportunityStatus @default(OFFERED)
  acceptedAt DateTime?
  createdAt  DateTime               @default(now())
  user       User?                  @relation(fields: [userId], references: [id])
  userId     String?

  @@unique([campaignId, agentId])
}

model AgentPlacementSubmission {
  id            String                @id @default(cuid())
  campaignId    String
  campaign      Campaign              @relation(fields: [campaignId], references: [id])
  agentId       String
  agent         Agent                 @relation(fields: [agentId], references: [id])
  placementId   String?
  placement     Placement?            @relation(fields: [placementId], references: [id])
  communityName String
  communityType String
  information   String
  proofUrl      String?
  notes         String?
  status        AgentSubmissionStatus @default(SUBMITTED)
  verification  VerificationStatus    @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  user          User?                 @relation(fields: [userId], references: [id])
  userId        String?
}

model CampaignAllocation {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  placementId    String?
  recipientId    String
  recipientType  String
  amount         Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([campaignId, recipientType])
}

model ClickEvent {
  id             String       @id @default(cuid())
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id])
  trackingLinkId String
  trackingLink   TrackingLink @relation(fields: [trackingLinkId], references: [id])
  placementId    String
  occurredAt     DateTime     @default(now())
  userAgent      String?
  source         String?

  @@index([campaignId, occurredAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
